PORT=5000

# For Local MongoDB:
# MONGODB_URI=mongodb://127.0.0.1:27017/notice-board

# For MongoDB Atlas (Deployment):
# Replace <username>, <password>, and cluster domain with your Atlas details:
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@cluster0.abcde.mongodb.net/notice-board?retryWrites=true&w=majority

JWT_SECRET=super-secret-jwt-key-vignan-notice-board-2026

# Allowed Frontend URL (or * for all):
CLIENT_ORIGIN=http://localhost:5173

# Staff Invite Codes for instant verification:
INVITE_CODE_FACULTY=FACULTY2026
INVITE_CODE_HOD=HOD2026
INVITE_CODE_DEAN=DEAN2026
